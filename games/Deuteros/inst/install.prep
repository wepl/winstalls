#version=2
#man-file=Manual
#P_MakeImages#2
      (set #CI_disknum 1)
      (set #CI_diskname ("%s Disk %ld" @app-name #CI_disknum))
      (set #CI_disklen 901120)
      (set #CI_skiptrk "1")
      (P_CreateImage)

      (set #CI_disknum 2)
      (set #CI_diskname ("%s Disk %ld" @app-name #CI_disknum))
      (set #CI_skiptrk "")
      (P_CreateImage)

      (set #choice
        (askbool
          (prompt "\nDo you have a Save Disk and want to have it installed ?")
          (default 1)
          (choices "Yes" "No")
          (help @askbool-help)
        )
      )
      (if
        (= #choice 1)
        (
          (set #CI_disknum 3)
          (set #CI_diskname ("%s Save Disk" @app-name))
          (set #CI_disklen 827904)
          (P_CreateImage)
        )
      )

